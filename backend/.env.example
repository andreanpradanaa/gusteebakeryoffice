# Salin file ini menjadi .env lalu isi API key. Kosongkan ANTHROPIC_API_KEY untuk mode demo.
ANTHROPIC_API_KEY=
# Model Claude yang dipakai semua agen
CLAUDE_MODEL=claude-opus-5-5
# Kedalaman berpikir: low | medium | high | xhigh | max (low = lebih cepat & hemat)
CLAUDE_EFFORT=medium
# Server-side refusal fallback (on/off)
CLAUDE_FALLBACKS=on
# Paksa mode demo walau API key terisi (1 = ya)
DEMO_MODE=
ADDR=:8080
DB_PATH=gustee.db
