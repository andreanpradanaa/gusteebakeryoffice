# Salin file ini menjadi .env lalu isi API key. Kosongkan ANTHROPIC_API_KEY untuk mode demo.
ANTHROPIC_API_KEY=
# Model Claude yang dipakai semua agen
CLAUDE_MODEL=claude-opus-5-5
# Kedalaman berpikir: low | medium | high | xhigh | max (low = lebih cepat & hemat)
CLAUDE_EFFORT=medium
# Server-side refusal fallback (on/off)
CLAUDE_FALLBACKS=on
# Provider LLM: anthropic (default) | openrouter
LLM_PROVIDER=anthropic
# Dipakai bila LLM_PROVIDER=openrouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Model format OpenRouter, mis. anthropic/claude-opus-5-5, openai/gpt-5, google/gemini-2.5-pro
OPENROUTER_MODEL=anthropic/claude-opus-5-5
# Paksa mode demo walau API key terisi (1 = ya)
DEMO_MODE=
ADDR=:8080
DB_PATH=gustee.db
# Lokasi data & aset (relatif terhadap folder backend)
SEED_FILE=data/seed.json
AGENTS_DIR=agents
# Folder hasil build frontend yang disajikan backend (produksi)
STATIC_DIR=../frontend/dist
# Origin yang diizinkan CORS (* = semua)
CORS_ORIGIN=*
